// Extension.xcconfig — production VoiceActivity extension overrides.
// The bundle ID must stay prefixed by App.xcconfig's, and the URL scheme
// must match App.xcconfig's exactly or the island deep-links elsewhere.
// The App Group must match App.xcconfig's character for character too: a
// container is shared only between bundles naming the identical group.

#include "Extension-Base.xcconfig"

APP_GROUP_ID = group.ai.anu.assistant-ios
BUNDLE_DISPLAY_NAME = ANU
BUNDLE_URL_SCHEME = vellum-assistant

// The ground the app's mark is drawn on, which must equal the
// `fill-specializations` solid in `App/AppIcon.icon/icon.json`: the widget
// draws the containing app's icon, and each build ships its own.
APP_ICON_GROUND = display-p3:1.00000,1.00000,1.00000,1.00000
PRODUCT_BUNDLE_IDENTIFIER = ai.anu.assistant-ios.VoiceActivity

// Exact portal profile name; must equal release-ios.yaml's `ext_profile_name`.
PROVISIONING_PROFILE_SPECIFIER_Manual = ANU iOS VoiceActivity Distribution
