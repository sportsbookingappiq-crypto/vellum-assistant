# Copy to anu/.env for local runs, or run `bun run db:setup`, which writes
# anu/.env with generated secrets. Never commit real values.
# In the cloud environment, set the same names in the environment settings.

# One of: dev, test, staging, production
ANU_ENV=dev

# The only sender today. Refused unless ANU_ENV is dev or test (ADR 0003).
OTP_SENDER=dev

# PostgreSQL. A `host` query parameter with an absolute path selects a Unix
# socket directory, for example:
# postgres://USER@localhost:5432/anu_platform?host=/var/run/postgresql
DATABASE_URL=
# Used by `bun test src`. Defaults to anu_platform_test over the local socket.
ANU_TEST_DATABASE_URL=
# Role the API switches to in every transaction, so row-level security applies.
# ANU_DB_APP_ROLE=anu_platform_app

# Secrets: at least 32 characters each. Generate with `openssl rand -hex 32`.
# ANU_OTP_SECRET keys the hashes of codes and client addresses.
# ANU_INTERNAL_TOKEN authenticates the sandbox server and the API to each other.
ANU_OTP_SECRET=
ANU_INTERNAL_TOKEN=

# API server
# ANU_API_HOST=127.0.0.1
# ANU_API_PORT=8787
# ANU_API_URL=http://127.0.0.1:8787
# ANU_SESSION_TTL_SECONDS=86400
# ANU_CORS_ORIGINS=capacitor://localhost,https://localhost,http://localhost:*
# Set to 1 only behind a proxy you control; then X-Forwarded-For is trusted.
# ANU_TRUST_PROXY=0
# ANU_RATE_WINDOW_SECONDS=900
# ANU_RATE_PHONE_MAX=5
# ANU_RATE_CLIENT_MAX=20

# Sandbox server
# ANU_SANDBOX_HOST=127.0.0.1
# ANU_SANDBOX_PORT=8788
# ANU_SANDBOX_URL=http://127.0.0.1:8788
# ANU_SANDBOX_ROOT=anu/.data/sandboxes
# One of: scripted, kilo, harness
ANU_SANDBOX_DRIVER=scripted
# ANU_TASK_TIMEOUT_SECONDS=600
# ANU_SESSION_IDLE_SECONDS=600
# ANU_SCRIPTED_STEP_DELAY_MS=300
# ANU_ASSISTANT_DIR=../assistant

# Kilo Gateway test provider (ADR 0004). The literal key `anonymous` works
# for the free models, so it is not a secret. A real key is.
KILO_BASE_URL=https://ai-gateway.kilo.ai/api/v1
KILO_API_KEY=anonymous
KILO_MODEL=kilo-auto/free

# Opt-in live tests
# ANU_LIVE_KILO=1
# ANU_LIVE_HARNESS=1
