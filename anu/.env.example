# Copy to anu/.env for local runs. Never commit real values.
# In the cloud environment, set the same names in the environment settings.

# One of: dev, test, staging, production
ANU_ENV=test

# The only sender today. Refused unless ANU_ENV is dev or test (ADR 0003).
OTP_SENDER=dev

# Kilo Gateway test provider (ADR 0004). Leave commented out until set.
# KILO_BASE_URL=
# KILO_API_KEY=
